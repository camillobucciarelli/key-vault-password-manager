// Pulls in Flutter's FLUTTER_BUILD_NAME/FLUTTER_BUILD_NUMBER (regenerated by
// `flutter build` before every archive) so this extension target's
// MARKETING_VERSION/CURRENT_PROJECT_VERSION stay in sync with the Runner
// app. Without this, $(FLUTTER_BUILD_NAME)/$(FLUTTER_BUILD_NUMBER) resolve
// to empty strings here (undefined outside Runner's own xcconfig chain),
// which Apple rejects on upload as missing CFBundleVersion/
// CFBundleShortVersionString.
#include "../Flutter/Generated.xcconfig"
