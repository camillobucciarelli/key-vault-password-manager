{
  "version": 1,
  "description": "Shared exact-origin canonicalization vectors for spec 009 (SR-2). Single source of truth for the Node harness and, from Slice A1 on, the Dart native-host tests. Neither suite may duplicate these expected values in source. Contains no secrets: every host is a documentation/reserved name (RFC 2606 example.com, RFC 3849 2001:db8::/32, RFC 5737-style loopback) and no case carries a credential.",
  "requiredIds": [
    "https-mixed-case",
    "https-default-port",
    "https-nondefault-port",
    "http-default-port",
    "http-nondefault-port",
    "idna-unicode",
    "idna-ascii",
    "ipv6-default-port",
    "ipv6-expanded",
    "ipv6-nondefault-port",
    "trailing-dot",
    "userinfo-name",
    "userinfo-password",
    "ipv4-canonical",
    "ipv4-shorthand",
    "ipv4-leading-zero",
    "ipv4-octal",
    "ipv4-hex",
    "ipv4-dword",
    "scheme-ftp",
    "scheme-file",
    "scheme-data",
    "scheme-javascript",
    "scheme-extension"
  ],
  "distinctGroups": [
    {
      "id": "scheme-differs",
      "reason": "http and https are different origins even for the same host.",
      "caseIds": ["http-plain", "https-plain"]
    },
    {
      "id": "port-differs",
      "reason": "An explicit non-default port is a different origin.",
      "caseIds": ["https-plain", "https-nondefault-port"]
    },
    {
      "id": "phishing-suffix-differs",
      "reason": "example.com and example.com.evil.test share no origin.",
      "caseIds": ["https-plain", "phishing-suffix"]
    },
    {
      "id": "host-prefix-labels-preserved",
      "reason": "Every hostname label is significant. The Dart possible-match helper strips www./m./mobile. via _cleanHost; that rule must never reach this authorization path.",
      "caseIds": [
        "https-plain",
        "www-label-preserved",
        "m-label-preserved",
        "mobile-label-preserved"
      ]
    }
  ],
  "equalGroups": [
    {
      "id": "idna-forms-equal",
      "reason": "Unicode and punycode spellings of the same name are one origin.",
      "caseIds": ["idna-unicode", "idna-ascii"]
    },
    {
      "id": "implicit-and-explicit-default-port-equal",
      "reason": "Port 443 is implicit for https.",
      "caseIds": ["https-plain", "https-default-port", "https-mixed-case"]
    },
    {
      "id": "ipv6-forms-equal",
      "reason": "Expanded and compressed IPv6 literals are one origin.",
      "caseIds": ["ipv6-default-port", "ipv6-expanded"]
    },
    {
      "id": "trailing-dot-equal",
      "reason": "A terminal dot is removed consistently.",
      "caseIds": ["https-plain", "trailing-dot"]
    }
  ],
  "cases": [
    {
      "id": "https-plain",
      "input": "https://example.com/login",
      "valid": true,
      "canonicalOrigin": "https://example.com",
      "effectivePort": 443,
      "permissionPattern": "https://example.com/*",
      "error": null
    },
    {
      "id": "http-plain",
      "input": "http://example.com/login",
      "valid": true,
      "canonicalOrigin": "http://example.com",
      "effectivePort": 80,
      "permissionPattern": "http://example.com/*",
      "error": null
    },
    {
      "id": "https-mixed-case",
      "input": "https://EXAMPLE.com/login",
      "valid": true,
      "canonicalOrigin": "https://example.com",
      "effectivePort": 443,
      "permissionPattern": "https://example.com/*",
      "error": null
    },
    {
      "id": "https-default-port",
      "input": "https://example.com:443/a",
      "valid": true,
      "canonicalOrigin": "https://example.com",
      "effectivePort": 443,
      "permissionPattern": "https://example.com/*",
      "error": null
    },
    {
      "id": "https-nondefault-port",
      "input": "https://example.com:8443/a",
      "valid": true,
      "canonicalOrigin": "https://example.com:8443",
      "effectivePort": 8443,
      "permissionPattern": "https://example.com/*",
      "error": null
    },
    {
      "id": "http-default-port",
      "input": "http://example.com:80/a",
      "valid": true,
      "canonicalOrigin": "http://example.com",
      "effectivePort": 80,
      "permissionPattern": "http://example.com/*",
      "error": null
    },
    {
      "id": "http-nondefault-port",
      "input": "http://example.com:8080/a",
      "valid": true,
      "canonicalOrigin": "http://example.com:8080",
      "effectivePort": 8080,
      "permissionPattern": "http://example.com/*",
      "error": null
    },
    {
      "id": "idna-unicode",
      "input": "https://bücher.example/a",
      "valid": true,
      "canonicalOrigin": "https://xn--bcher-kva.example",
      "effectivePort": 443,
      "permissionPattern": "https://xn--bcher-kva.example/*",
      "error": null
    },
    {
      "id": "idna-ascii",
      "input": "https://xn--bcher-kva.example/a",
      "valid": true,
      "canonicalOrigin": "https://xn--bcher-kva.example",
      "effectivePort": 443,
      "permissionPattern": "https://xn--bcher-kva.example/*",
      "error": null
    },
    {
      "id": "ipv6-default-port",
      "input": "https://[2001:db8::1]:443/a",
      "valid": true,
      "canonicalOrigin": "https://[2001:db8::1]",
      "effectivePort": 443,
      "permissionPattern": "https://[2001:db8::1]/*",
      "error": null
    },
    {
      "id": "ipv6-expanded",
      "input": "https://[2001:0db8:0:0:0:0:0:1]/a",
      "valid": true,
      "canonicalOrigin": "https://[2001:db8::1]",
      "effectivePort": 443,
      "permissionPattern": "https://[2001:db8::1]/*",
      "error": null
    },
    {
      "id": "ipv6-nondefault-port",
      "input": "https://[2001:db8::1]:8443/a",
      "valid": true,
      "canonicalOrigin": "https://[2001:db8::1]:8443",
      "effectivePort": 8443,
      "permissionPattern": "https://[2001:db8::1]/*",
      "error": null
    },
    {
      "id": "trailing-dot",
      "input": "https://example.com./a",
      "valid": true,
      "canonicalOrigin": "https://example.com",
      "effectivePort": 443,
      "permissionPattern": "https://example.com/*",
      "error": null
    },
    {
      "id": "www-label-preserved",
      "input": "https://www.example.com/a",
      "valid": true,
      "canonicalOrigin": "https://www.example.com",
      "effectivePort": 443,
      "permissionPattern": "https://www.example.com/*",
      "error": null
    },
    {
      "id": "m-label-preserved",
      "input": "https://m.example.com/a",
      "valid": true,
      "canonicalOrigin": "https://m.example.com",
      "effectivePort": 443,
      "permissionPattern": "https://m.example.com/*",
      "error": null
    },
    {
      "id": "mobile-label-preserved",
      "input": "https://mobile.example.com/a",
      "valid": true,
      "canonicalOrigin": "https://mobile.example.com",
      "effectivePort": 443,
      "permissionPattern": "https://mobile.example.com/*",
      "error": null
    },
    {
      "id": "phishing-suffix",
      "input": "https://example.com.evil.test/a",
      "valid": true,
      "canonicalOrigin": "https://example.com.evil.test",
      "effectivePort": 443,
      "permissionPattern": "https://example.com.evil.test/*",
      "error": null
    },
    {
      "id": "ipv4-canonical",
      "input": "https://127.0.0.1/a",
      "valid": true,
      "canonicalOrigin": "https://127.0.0.1",
      "effectivePort": 443,
      "permissionPattern": "https://127.0.0.1/*",
      "error": null
    },
    {
      "id": "userinfo-name",
      "input": "https://alice@example.com/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "userinfo_forbidden"
    },
    {
      "id": "userinfo-password",
      "input": "https://alice:redacted@example.com/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "userinfo_forbidden"
    },
    {
      "id": "userinfo-empty",
      "input": "https://@example.com/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "userinfo_forbidden",
      "note": "Only the raw-authority check catches this: the URL parser reports empty username and password, so a parser-only guard would accept it as https://example.com."
    },
    {
      "id": "userinfo-empty-colon",
      "input": "https://:@example.com/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "userinfo_forbidden",
      "note": "Same as userinfo-empty, with an empty password component."
    },
    {
      "id": "ipv4-shorthand",
      "input": "https://127.1/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "noncanonical_ipv4"
    },
    {
      "id": "ipv4-leading-zero",
      "input": "https://127.000.000.001/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "noncanonical_ipv4"
    },
    {
      "id": "ipv4-octal",
      "input": "https://0177.0.0.1/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "noncanonical_ipv4"
    },
    {
      "id": "ipv4-hex",
      "input": "https://0x7f.0.0.1/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "noncanonical_ipv4"
    },
    {
      "id": "ipv4-dword",
      "input": "https://2130706433/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "noncanonical_ipv4"
    },
    {
      "id": "scheme-ftp",
      "input": "ftp://example.com/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "scheme_forbidden"
    },
    {
      "id": "scheme-file",
      "input": "file:///tmp/a",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "scheme_forbidden"
    },
    {
      "id": "scheme-data",
      "input": "data:text/plain,hello",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "scheme_forbidden"
    },
    {
      "id": "scheme-javascript",
      "input": "javascript:alert(1)",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "scheme_forbidden"
    },
    {
      "id": "scheme-extension",
      "input": "chrome-extension://abcdefghijklmnopabcdefghijklmnop/page.html",
      "valid": false,
      "canonicalOrigin": null,
      "effectivePort": null,
      "permissionPattern": null,
      "error": "scheme_forbidden"
    }
  ]
}
