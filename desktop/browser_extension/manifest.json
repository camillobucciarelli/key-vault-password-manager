{
  "manifest_version": 3,
  "name": "KeyVault Browser Autofill",
  "version": "0.1.0",
  "description": "Fill login forms from your local KeyVault database.",
  "permissions": ["activeTab", "tabs", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KeyVault Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
