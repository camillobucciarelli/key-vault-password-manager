{
  "manifest_version": 3,
  "name": "KeyVault Browser Autofill BETA",
  "version": "0.4.0",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Autofill for KeyVault; requires the local KeyVault desktop app and Native Messaging host.",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KeyVault Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
