<?xml version="1.0" encoding="utf-8"?>
<!--
  spec 023 T403 — what KeyVault offers Credential Manager.

  Passkeys only. Passwords stay with the autofill service of spec 016:
  declaring TYPE_PASSWORD_CREDENTIAL here as well would put the same
  credential in two system pickers, and the user would have to guess which one
  fills.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsSubtitle="@string/autofill_service_label">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
