<?xml version="1.0" encoding="utf-8"?>
<!-- spec 014 FR-7 (T013): managed vault storage never enters cloud backup or
     device-to-device transfer. Vaults, key files and metadata live in the
     app-private files dir; excluding the whole domain keeps opaque names and
     encrypted metadata off any backup transport. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
