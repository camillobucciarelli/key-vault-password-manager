<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kv_picker_surface" />
            <stroke
                android:width="@dimen/kv_picker_focus_ring"
                android:color="@color/kv_picker_focus" />
            <corners android:radius="@dimen/kv_picker_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kv_picker_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/kv_picker_divider" />
            <corners android:radius="@dimen/kv_picker_radius" />
        </shape>
    </item>
</selector>
