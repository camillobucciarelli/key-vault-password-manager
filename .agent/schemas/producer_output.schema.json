{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "producer_output.schema.json",
  "title": "ProducerOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["iteration", "candidate", "self_checks", "confidence"],
  "properties": {
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "rationale"],
      "properties": {
        "data": {
          "type": "object"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "self_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "pass"],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "pass": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
