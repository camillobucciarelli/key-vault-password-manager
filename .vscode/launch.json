{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "flutter run",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file=.env.dart.define.json"
            ]
        },
        {
            "name": "flutter run (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define-from-file=.env.dart.define.json"
            ]
        },
        {
            "name": "flutter run (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file=.env.dart.define.json"
            ]
        },
        {
            "name": "flutter run (macOS + Drive OAuth)",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos",
            "args": [
                "--dart-define-from-file=.env.dart.define.json"
            ]
        },
        {
            "name": "flutter run (mobile + Drive OAuth)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file=.env.dart.define.json"
            ]
        }
    ]
